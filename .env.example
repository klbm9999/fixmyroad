# API
PORT=3001
NODE_ENV=development
CORS_ORIGIN=http://localhost:3000

# Database (PostgreSQL + PostGIS)
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=fixmyroad
DB_LOGGING=false

# JWT
JWT_SECRET=change-me-in-production
JWT_EXPIRES_IN=15m

# Redis (optional; for photo-hash dedup and map cache)
REDIS_URL=redis://localhost:6379

# reCAPTCHA (optional; when set, register/report require recaptchaToken)
RECAPTCHA_SECRET=

# S3 (optional; for presigned URLs)
S3_PUBLIC_BASE_URL=https://storage.example.com

# Web (for Next.js)
NEXT_PUBLIC_API_URL=http://localhost:3001
